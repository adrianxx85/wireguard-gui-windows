<Window x:Class="WGClient.NewTunnelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neuen Tunnel erstellen" Width="640" Height="700" MinWidth="560" MinHeight="560"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="KeyBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Margin" Value="0,5,0,14"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Kopf mit Fortschritt -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="28,18,28,16">
            <StackPanel>
                <TextBlock Text="{Binding StepCaption}" Style="{StaticResource Muted}"/>
                <TextBlock Text="{Binding StepTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0"/>
                <UniformGrid Columns="3" Margin="0,12,0,0">
                    <Border Height="3" CornerRadius="2" Margin="0,0,4,0" Background="{Binding Bar1}"/>
                    <Border Height="3" CornerRadius="2" Margin="2,0,2,0" Background="{Binding Bar2}"/>
                    <Border Height="3" CornerRadius="2" Margin="4,0,0,0" Background="{Binding Bar3}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Fußzeile -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Abbrechen" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0"/>
                    <Button Content="Zurück" Click="Back_Click" IsEnabled="{Binding CanGoBack}" Margin="0,0,8,0"/>
                    <Button Content="{Binding NextText}" Style="{StaticResource AccentButton}" MinWidth="130"
                            IsDefault="True" IsEnabled="{Binding IsIdle}" Click="Next_Click"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Info}" Style="{StaticResource Muted}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,20,28,20">

                <!-- ===== Schritt 1: dieses Gerät ===== -->
                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding NameHint}" Style="{StaticResource Hint}"/>

                    <TextBlock Text="Tunnel-Adresse dieses Geräts" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Die IP-Adresse im VPN, z. B. 10.8.0.2/32 – bekommst du vom Server-Betreiber. Mehrere mit Komma trennen (z. B. zusätzlich IPv6)."/>

                    <TextBlock Text="DNS-Server (optional)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Dns, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="z. B. 10.8.0.1 oder 1.1.1.1. Leer lassen = DNS von Windows verwenden."/>

                    <TextBlock Text="Schlüssel" Style="{StaticResource SectionHeader}" Margin="0,8,0,8"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                               Text="Für dieses Gerät wird automatisch ein neues Schlüsselpaar erzeugt. Der private Schlüssel bleibt auf diesem PC – an den Server geht nur der öffentliche."/>
                    <CheckBox IsChecked="{Binding UseOwnKey}">
                        <StackPanel>
                            <TextBlock Text="Vorhandenen privaten Schlüssel verwenden"/>
                            <TextBlock Style="{StaticResource Muted}" Text="Nur nötig, wenn der Server-Betreiber dir einen Schlüssel vorgegeben hat."/>
                        </StackPanel>
                    </CheckBox>
                    <TextBox Text="{Binding OwnPrivateKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource KeyBox}" Margin="0,10,0,0"
                             Visibility="{Binding UseOwnKey, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- ===== Schritt 2: Server ===== -->
                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Öffentlicher Schlüssel des Servers" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding ServerPublicKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource KeyBox}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="44 Zeichen, endet auf „=“. Steht in der Server-Konfiguration bzw. kommt vom Server-Betreiber."/>

                    <TextBlock Text="Endpoint" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Adresse und Port des Servers, z. B. vpn.example.com:51820 (Standardport von WireGuard ist 51820)."/>

                    <TextBlock Text="Pre-shared Key (optional)" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Erzeugen" Margin="8,0,0,0" Click="GeneratePsk_Click" IsEnabled="{Binding IsIdle}"/>
                        <TextBox Text="{Binding PresharedKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource KeyBox}"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Zusätzliche Absicherung. Muss auf dem Server identisch eingetragen sein – sonst leer lassen."/>

                    <TextBlock Text="Routing" Style="{StaticResource SectionHeader}" Margin="0,8,0,10"/>
                    <RadioButton IsChecked="{Binding IsFullTunnel}">
                        <StackPanel>
                            <TextBlock Text="Gesamten Traffic durch den Tunnel leiten" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Muted}" Text="Internet und alle Netze laufen über den Server (0.0.0.0/0, ::/0). Kill-Switch ist aktiv."/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton IsChecked="{Binding IsSplit}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Nur bestimmte Netze (Split-Tunnel)" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Muted}" Text="Nur die angegebenen Netze gehen durch den Tunnel, alles andere direkt ins Internet."/>
                        </StackPanel>
                    </RadioButton>
                    <StackPanel Margin="4,12,0,0" Visibility="{Binding IsSplit, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Netze (AllowedIPs), durch Komma getrennt:" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding SplitAllowedIps, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="z. B. 10.8.0.0/24, 192.168.0.0/24 (VPN-Netz und Heimnetz hinter dem Server)."/>
                    </StackPanel>

                    <TextBlock Text="Keepalive (Sekunden)" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                    <TextBox Text="{Binding Keepalive, UpdateSourceTrigger=PropertyChanged}" Width="110" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Hält die Verbindung hinter Routern offen. 25 ist ein guter Wert, leer oder 0 = aus."/>
                </StackPanel>

                <!-- ===== Schritt 3: Zusammenfassung ===== -->
                <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">
                    <Border Background="#16263F" BorderBrush="#2B4A7A" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <TextBlock TextWrapping="Wrap" Foreground="#CFE0FF"
                                   Text="Fast geschafft! Trage den folgenden Block in die Konfiguration des WireGuard-Servers ein (oder schicke ihn dem Server-Betreiber). Erst danach kann die Verbindung aufgebaut werden."/>
                    </Border>

                    <DockPanel Margin="0,18,0,8">
                        <Button DockPanel.Dock="Right" Content="Kopieren" Click="CopySnippet_Click"/>
                        <TextBlock Text="Für den Server" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox Text="{Binding ServerSnippet, Mode=OneWay}" Style="{StaticResource CodeBox}" MinHeight="96"/>

                    <TextBlock Text="Öffentlicher Schlüssel dieses Geräts" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                    <TextBox Text="{Binding PublicKey, Mode=OneWay}" Style="{StaticResource KeyBox}" IsReadOnly="True"/>

                    <TextBlock Text="Konfiguration dieses Geräts" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,8"/>
                    <TextBox Text="{Binding ConfigPreview, Mode=OneWay}" Style="{StaticResource CodeBox}" MaxHeight="230"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Private Schlüssel sind ausgeblendet. Kill-Switch, LAN-Zugriff, Autostart usw. stellst du nach dem Erstellen im Reiter „Optionen“ ein."/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
