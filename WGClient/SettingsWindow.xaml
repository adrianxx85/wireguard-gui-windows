<Window x:Class="WGClient.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WGClient"
        Title="Einstellungen" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="UpdateButton" Visibility="Collapsed" Click="Update_Click" Margin="0,0,8,0"/>
            <Button Content="Schließen" IsCancel="True"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="WireGuard" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="WG Client"/>
                <TextBlock Grid.Column="1" Text="{x:Static local:App.VersionLabel}"/>
                <TextBlock Grid.Row="1" Text="Edition" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="EditionLabel" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="2" x:Name="ComponentLabel" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InstalledVersionLabel" Margin="0,6,0,0"/>
            </Grid>
            <Button x:Name="CheckButton" Content="Nach Updates suchen" Style="{StaticResource AccentButton}"
                    HorizontalAlignment="Left" Click="Check_Click"/>
            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </DockPanel>
</Window>
